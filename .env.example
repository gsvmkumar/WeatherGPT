# ============================================================
# WeatherGPT — Master Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit any real .env or .env.local file to version control.
# ============================================================

# ── Database (PostgreSQL) ──────────────────────────────────
# Connection string format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/weathergpt

# ── Google Gemini LLM ──────────────────────────────────────
# Obtain your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Weather API ────────────────────────────────────────────
# Primary provider: Open-Meteo (free, open, no API key required)
WEATHER_API_PROVIDER=open_meteo

# ── Security & Authentication ──────────────────────────────
# Secret key for HMAC-SHA256 JWT access tokens.
# Use a strong, long, cryptographically random string in production.
SECRET_KEY=your_long_random_jwt_secret_key_here

# ── CORS Settings ──────────────────────────────────────────
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Alert Thresholds (Meteorological) ──────────────────────
ALERT_RAIN_PROBABILITY_THRESHOLD=70
ALERT_TEMP_HIGH_THRESHOLD=40.0
ALERT_WIND_SPEED_THRESHOLD=50.0
ALERT_HUMIDITY_THRESHOLD=90

# ── Optional: Email / SMTP Configuration ───────────────────
# Configured if you wish to enable automated transactional emails
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here

# ── Frontend (Next.js) ─────────────────────────────────────
# Place these variables in frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# ── Mobile (React Native / Expo) ───────────────────────────
# Optional: override default Metro dynamic backend discovery
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
