# WeatherGPT Frontend (Next.js) — Environment Configuration Template
# Copy this file to frontend/.env.local
# NEVER commit frontend/.env.local to version control.

# FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Default UI Language (en, te, hi, ta, kn, ml, mr, bn)
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
