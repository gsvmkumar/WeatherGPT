# WeatherGPT Backend — Environment Configuration Template
# Copy this file to backend/.env and populate your actual local credentials.
# NEVER commit the real backend/.env file to version control.

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/weathergpt

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Weather Provider
WEATHER_API_PROVIDER=open_meteo

# JWT Security
SECRET_KEY=your_long_random_jwt_secret_key_here

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Weather Alert Triggers
ALERT_RAIN_PROBABILITY_THRESHOLD=70
ALERT_TEMP_HIGH_THRESHOLD=40.0
ALERT_WIND_SPEED_THRESHOLD=50.0
ALERT_HUMIDITY_THRESHOLD=90

# Optional: SMTP Email Settings
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
